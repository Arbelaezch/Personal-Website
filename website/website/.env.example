# Copy this file to .env in the same folder (website/website/.env). Never commit .env.
# Loaded by python-dotenv when Django starts.

# Required. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Local development only (1 = on). Leave unset or 0 in production: DEBUG off turns on the
# production security settings (HTTPS redirect, secure cookies, ...).
DEBUG=1

# Space-separated hosts. Required when DEBUG is off; defaults to localhost when DEBUG is on.
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

# Database used when DEBUG=1 (MySQL in dev/prod for parity; sqlite3 works for a quick local run:
# ENGINE=django.db.backends.sqlite3 and NAME=db.sqlite3, other values blank)
DEV_DB_ENGINE=django.db.backends.mysql
DEV_DB_HOST=localhost
DEV_DB_PORT=3306
DEV_DB_NAME=portfolio_dev
DEV_DB_USER=
DEV_DB_PASSWORD=

# Database used when DEBUG is off (production)
PROD_DB_ENGINE=django.db.backends.mysql
PROD_DB_HOST=localhost
PROD_DB_PORT=3306
PROD_DB_NAME=portfolio_prod
PROD_DB_USER=
PROD_DB_PASSWORD=
